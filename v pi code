import asyncio
import datetime
import os
import sqlite3
import threading
from fastapi import FastAPI, Response
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import StreamingResponse
from pydantic import BaseModel
import cv2
import numpy as np
import onnxruntime as ort

# For Raspberry Pi camera streaming integration
from picamera2 import PiCamera2
from picamera2.outputs import FrameOutput

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
) 

DB_PATH = "app.db"

# =========================
# ONNX MODEL INIT
# =========================
session = ort.InferenceSession(
    "model/ecobarter_beta_v1.onnx",
    providers=["CPUExecutionProvider"]
)
input_name = session.get_inputs()[0].name

# =========================
# CAMERA STREAMING INIT
# =========================
picam2 = None
frame_output = None
camera_thread = None

def start_camera_capture():
    """Initializes the hardware camera and pipes it into an in-memory buffer."""
    global picam2, frame_output
    try:
        picam2 = PiCamera2()
        config = picam2.create_video_configuration(main={"size": (1280, 720), "format": "RGB888"})
        picam2.configure(config)
        
        frame_output = FrameOutput()
        picam2.start_recording(frame_output, format="jpeg")
        print("Camera capture thread started successfully.")
    except Exception as e:
        print(f"Camera Initialization Failed (Are you running on a Pi?): {e}")

# =========================
# DATABASE INIT
# =========================
def init_db():
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute("PRAGMA foreign_keys = ON")
        cursor = conn.cursor()
        cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            patient_id TEXT UNIQUE,
            first_name TEXT,
            surname TEXT,
            created_at TEXT
        )
        """)
        cursor.execute("""
        CREATE TABLE IF NOT EXISTS analysis (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            file_dir TEXT,
            status TEXT,
            grade TEXT,
            created_at TEXT,
            FOREIGN KEY (user_id) REFERENCES users(id)
        )
        """)
        conn.commit()

@app.on_event("startup")
async def startup_event():
    init_db()
    # Spin camera capture up in a dedicated thread to keep standard API loops hyper-fast
    global camera_thread
    camera_thread = threading.Thread(target=start_camera_capture, daemon=True)
    camera_thread.start()

# =========================
# REQUEST PYDANTIC MODELS
# =========================
class User(BaseModel):
    patient_id: str
    first_name: str
    surname: str

class AnalyseRequest(BaseModel):
    file_dir: str  # Set to "CAMERA" if you want to analyze the live camera frame!
    user_id: int  

# =========================
# HELPERS & COMPUTER VISION
# =========================
def preprocess_image(img):
    if img is None:
        return None
    img = cv2.resize(img, (640, 640))
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    img = img.astype(np.float32) / 255.0
    img = np.transpose(img, (2, 0, 1))
    img = np.expand_dims(img, axis=0)
    return img

def run_model(image_path_or_cv_img):
    # Check if we passed a file path string or a raw decoded NumPy image matrix
    if isinstance(image_path_or_cv_img, str):
        img_matrix = cv2.imread(image_path_or_cv_img)
    else:
        img_matrix = image_path_or_cv_img

    img = preprocess_image(img_matrix)
    if img is None:
        return None

    outputs = session.run(None, {input_name: img})
    raw_predictions = outputs[0]
    
    # NOTE: Your model returns a raw array, but your endpoint treats it as a dict.
    # Map your raw ONNX floating-point outputs to status and grade classes here!
    # Example parsing placeholder:
    parsed_result = {
        "status": "success", 
        "grade": f"Class_{np.argmax(raw_predictions)}"
    }
    return parsed_result

async def frame_generator():
    """Asynchronous generator streaming real-time MJPEG chunks to client."""
    global frame_output
    while True:
        if frame_output is not None:
            frame = frame_output.get_frame()
            if frame:
                yield (b'--frame\r\n'
                       b'Content-Type: image/jpeg\r\n\r\n' + frame + b'\r\n')
        await asyncio.sleep(0.04) # Enforces ~25 FPS non-blocking cadence

# =========================
# CAMERA STREAM ENDPOINTS
# =========================
@app.get("/video_feed")
async def video_feed():
    """Point your HTML frontend <img> tag src directly here for live video."""
    return StreamingResponse(
        frame_generator(), 
        media_type="multipart/x-mixed-replace; boundary=frame"
    )

@app.get("/snapshot")
async def snapshot():
    """Grabs a single high-quality snapshot frame on demand."""
    if frame_output is not None:
        frame = frame_output.get_frame()
        if frame:
            return Response(content=frame, media_type="image/jpeg")
    return Response(status_code=503, content="Camera frame buffer unreadable")

