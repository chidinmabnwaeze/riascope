# =========================
# OPENCV PICAMERA2 GLOBAL CAMERA ENGINE
# =========================
latest_jpeg_frame = None  # Storage for our active JPEG stream bytes
latest_raw_frame = None   # Storage for the latest raw BGR frame for analysis

def start_camera_capture():
    """Direct camera capture thread using native Picamera2 API."""
    global latest_jpeg_frame

    print("🚀 Connecting natively to IMX477 via Picamera2...")
    
    try:
        picam = Picamera2()
        
        # Configure output format directly to standard RGB at 640x480
        cam_config = picam.create_preview_configuration(
            main={"format": "RGB888", "size": (640, 480)},
            # controls={
            #     "AwbEnable": True,
            #     "AwbMode": 1  # auto white balance
            # }
        )
        picam.configure(cam_config)
        picam.start()
        
        print("✅ Picamera2 capture thread running smoothly without matrix faults.")
        time.sleep(0.5)  # Allow sensor matrix to warm up auto-exposure
        
        while True:
            # Capture directly into a structured numpy array
            frame_rgb = picam.capture_array()
            
            if frame_rgb is not None and frame_rgb.size > 0:
                # Picamera2 outputs standard RGB; convert to BGR for OpenCV usage
                frame_bgr = cv2.cvtColor(frame_rgb, cv2.COLOR_RGB2BGR)
                
               # Save original frame for AI
                latest_raw_frame = frame_bgr.copy()

                # Create display copy
                display_frame = frame_bgr.copy()

                h, w = display_frame.shape[:2]

                # ROI (Region Of Interest)
                x1 = int(w * 0.2)
                y1 = int(h * 0.2)
                x2 = int(w * 0.8)
                y2 = int(h * 0.8)

                # --------------------------
                # Darken outside the box
                # --------------------------
                overlay = display_frame.copy()

                cv2.rectangle(
                    overlay,
                    (0, 0),
                    (w, h),
                    (0, 0, 0),
                    -1
                )

                cv2.rectangle(
                    overlay,
                    (x1, y1),
                    (x2, y2),
                    (255, 255, 255),
                    -1
                )

                display_frame = cv2.addWeighted(
                    overlay,
                    0.25,
                    display_frame,
                    0.75,
                    0
                )

                # --------------------------
                # Draw corner markers
                # --------------------------
                corner = 30
                thickness = 3
                green = (0, 255, 0)

                # Top Left
                cv2.line(display_frame, (x1, y1), (x1 + corner, y1), green, thickness)
                cv2.line(display_frame, (x1, y1), (x1, y1 + corner), green, thickness)

                # Top Right
                cv2.line(display_frame, (x2, y1), (x2 - corner, y1), green, thickness)
                cv2.line(display_frame, (x2, y1), (x2, y1 + corner), green, thickness)

                # Bottom Left
                cv2.line(display_frame, (x1, y2), (x1 + corner, y2), green, thickness)
                cv2.line(display_frame, (x1, y2), (x1, y2 - corner), green, thickness)

                # Bottom Right
                cv2.line(display_frame, (x2, y2), (x2 - corner, y2), green, thickness)
                cv2.line(display_frame, (x2, y2), (x2, y2 - corner), green, thickness)

                # Compress the raw BGR matrix frame into a JPEG byte sequence
                _, buffer = cv2.imencode('.jpg', display_frame)
                latest_jpeg_frame = buffer.tobytes()
            else:
                time.sleep(0.05)
                continue
              
            time.sleep(0.03)  # Stable ~30 FPS pacing footprint

    except Exception as e:
        print(f"❌ CRITICAL: Picamera2 thread crashed: {e}")
    finally:
        if 'picam' in locals():
            picam.stop()
            print("📷 Camera released cleanly.")



