@app.post("/users")
def create_user(user: User):
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO users (patient_id, first_name, surname, created_at)
            VALUES (?, ?, ?, ?)
        """, (
            user.patient_id,
            user.first_name,
            user.surname,
            datetime.datetime.now().isoformat()
        ))
        conn.commit()
    return {"message": "User created successfully"}

@app.get("/users/{id}")
def get_user(id: int):
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM users WHERE id = ?", (id,))
        data = cursor.fetchone()
        
    if not data:
        return {"error": "User not found"}

    return {
        "id": data[0],
        "patient_id": data[1],
        "first_name": data[2],
        "surname": data[3],
        "created_at": data[4]
    }

@app.get("/users")
def get_all_users(patient_id: str = None, name: str = None):
    query = "SELECT * FROM users WHERE 1=1"
    params = []

    if patient_id:
        query += " AND patient_id = ?"
        params.append(patient_id)

    if name:
        query += " AND (first_name LIKE ? OR surname LIKE ?)"
        params.append(f"%{name}%")
        params.append(f"%{name}%")

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute(query, params)
        data = cursor.fetchall()

    users = [{"id": r[0], "patient_id": r[1], "first_name": r[2], "surname": r[3], "created_at": r[4]} for r in data]
    return {"count": len(users), "users": users}

# =========================
# AI MODEL ANALYSIS ENDPOINT
# =========================
@app.post("/analyse")
def analyse(req: AnalyseRequest):
    global frame_output
    
    # COOL ADDITION: If file_dir is sent as "CAMERA", dynamically analyze the live stream!
    if req.file_dir.upper() == "CAMERA":
        if frame_output is None or frame_output.get_frame() is None:
            return {"error": "Camera stream is active but frame buffer is empty."}
        
        raw_bytes = frame_output.get_frame()
        # Decode the live frame bytes directly into an OpenCV matrix
        nparr = np.frombuffer(raw_bytes, np.uint8)
        target_img = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        save_location = f"analysis_snapshots/live_{int(datetime.datetime.now().timestamp())}.jpg"
        
        # Save snapshot for archival records
        os.makedirs("analysis_snapshots", exist_ok=True)
        cv2.imwrite(save_location, target_img)
        req.file_dir = save_location
    else:
        # Standard local file path routing
        if not os.path.exists(req.file_dir):
            return {"error": "File not found"}
        target_img = req.file_dir

    # Process via ONNX model engine
    pred = run_model(target_img)

    if pred is None:
        status = "failed"
        grade = "unknown"
    else:
        status = pred["status"]
        grade = pred["grade"]

    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO analysis (user_id, file_dir, status, grade, created_at)
            VALUES (?, ?, ?, ?, ?)
        """, (
            req.user_id,
            req.file_dir,
            status,
            grade,
            datetime.datetime.now().isoformat()
        ))
        conn.commit()

    return {
        "user_id": req.user_id,
        "status": status,
        "grade": grade,
        "saved_file": req.file_dir
    }

